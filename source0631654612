local function createLine(p1, p2)
    local frame = Instance.new("Frame")
    local dist = (p2 - p1).Magnitude
    local angle = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))

    frame.Size = UDim2.new(0, dist, 0, 2)
    frame.Position = UDim2.new(0, (p1.X + p2.X)/2, 0, (p1.Y + p2.Y)/2)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Rotation = angle
    frame.BackgroundColor3 = Color3.fromRGB(200, 240, 255)
    frame.BorderSizePixel = 0
    frame.ZIndex = 1
    frame.Parent = lightningContainer

    local glow = Instance.new("UIStroke")
    glow.Color = Color3.fromRGB(0, 150, 255)
    glow.Thickness = 2
    glow.Parent = frame

    return frame, glow
end

local function strikeLightning()
    local isHorizontal = math.random() > 0.5
    local startPos, endPos

    if isHorizontal then
        startPos = Vector2.new(0, math.random(0, 320))
        endPos = Vector2.new(260, math.random(0, 320))
    else
        startPos = Vector2.new(math.random(0, 260), 0)
        endPos = Vector2.new(math.random(0, 260), 320)
    end

    local steps = math.random(6, 10)
    local segments = {}
    local currentPos = startPos

    for i = 1, steps do
        local nextPos
        if i == steps then
            nextPos = endPos
        else
            local progress = i / steps
            local exX = startPos.X + (endPos.X - startPos.X) * progress
            local exY = startPos.Y + (endPos.Y - startPos.Y) * progress
            nextPos = Vector2.new(exX + math.random(-35, 35), exY + math.random(-35, 35))
        end

        local line, glow = createLine(currentPos, nextPos)
        table.insert(segments, {line, glow})
        currentPos = nextPos
    end

    task.spawn(function()
        task.wait(0.05)
        for _, s in ipairs(segments) do s[1].BackgroundTransparency = 0.5 s[2].Transparency = 0.5 end
        task.wait(0.05)
        for _, s in ipairs(segments) do s[1].BackgroundTransparency = 0 s[2].Transparency = 0 end
        task.wait(0.1)

        for _, s in ipairs(segments) do
            TweenService:Create(s[1], TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
            TweenService:Create(s[2], TweenInfo.new(0.5), {Transparency = 1}):Play()
        end
        task.wait(0.5)
        for _, s in ipairs(segments) do s[1]:Destroy() end
    end)
end

task.spawn(function()
    while mainFrame.Parent do
